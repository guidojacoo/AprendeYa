# fantasybot — serverless configuration
#
# Copy to `.env` for local use (it is gitignored), and set the same values in
# Vercel under Settings > Environment Variables. Never commit real values.
#
# Every variable says where to get it. Nothing here has a sensible default you
# can guess: if a value is wrong the bot fails loudly at /api rather than
# quietly doing nothing.

# =============================================================================
# VERCEL
# =============================================================================
# Your deployment's base URL, no trailing slash. After the first deploy Vercel
# shows it as "Domains": https://<project>.vercel.app
# Used by: the GitHub Actions workflow (as a repository VARIABLE, not a secret).
VERCEL_APP_URL=https://your-project.vercel.app

# =============================================================================
# SUPABASE
# =============================================================================
# supabase.com > your project > Project Settings > Data API
#
# SUPABASE_URL              "Project URL"        https://xxxxxxxx.supabase.co
# SUPABASE_ANON_KEY         "anon public" key    — NOT used by the bot; keep it
#                           listed only so you don't confuse the two keys.
# SUPABASE_SERVICE_ROLE_KEY "service_role" key   — THE ONE THE BOT USES.
#
# The service_role key bypasses Row Level Security. It belongs in Vercel's
# server-side environment and in your local .env, and NOWHERE ELSE: never in the
# browser, never in the repo, never in a client bundle. Anyone holding it owns
# your database. If it leaks, rotate it in the same dashboard page.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Which backend to use. Auto-detects: Supabase credentials present -> supabase,
# otherwise local JSON files. Set it explicitly to force one.
#   local     .state/*.json (the CLI default on your machine)
#   supabase  PostgreSQL (what Vercel must use — functions keep no disk)
# FANTASYBOT_STORAGE=supabase

# Namespace for every row. Change it to run a second team/league off the same
# free Supabase project without the two ever seeing each other.
# FANTASYBOT_SCOPE=default

# =============================================================================
# BOT
# =============================================================================
# The shared secret protecting /api/tick, /api/status and /api/admin. Anything
# without it gets a 401 — including an unset secret, which fails closed.
# Generate one:   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Goes in: Vercel env vars AND GitHub > Settings > Secrets > Actions.
BOT_CRON_SECRET=

# Optional. Vercel's own Cron sends `Authorization: Bearer $CRON_SECRET`. Set
# this to the SAME value as BOT_CRON_SECRET to enable the free daily backstop
# cron declared in vercel.json.
# CRON_SECRET=

# =============================================================================
# LALIGA FANTASY
# =============================================================================
# There is no API key: LaLiga uses OAuth, so the bot needs a session you created
# by logging in once, locally:
#
#   python -m fantasybot login                       # prints the login URL
#   # log in with Google; in DevTools > Network copy the 'authredirect://' URL
#   # from the request that shows "(canceled)"
#   python -m fantasybot login "authredirect://...?code=..."
#
# That writes tokens.json. Then EITHER push it into Supabase (preferred — the
# bot can then rotate it):
#   python scripts/migrate-state.py --tokens
# OR paste just the refresh_token here as a bootstrap:
#   python -c "import json;print(json.load(open('tokens.json'))['refresh_token'])"
#
# The refresh_token lasts 90 days. When it expires the bot stops and you log in
# again — that is a hard limit of LaLiga's OAuth, not of this deployment.
FANTASY_REFRESH_TOKEN=

# Which league to operate on. Leave unset for your first league.
# Find the id with:  python -m fantasybot leagues
# FANTASYBOT_LEAGUE=

# =============================================================================
# LLM (optional — the bot is fully functional, and free, without it)
# =============================================================================
# Unset, the bot is 100% deterministic: it optimises the lineup, prices flips and
# snipes bids with pure maths and spends nothing. The LLM only adds judgement
# (which targets to stretch for, what to remember week to week) and it NEVER
# executes anything — see fantasybot/llm/strategy.py.
#
# LLM_PROVIDER : none | groq | gemini | openrouter | anthropic | openai | deepseek | together
# LLM_API_KEY  : the provider's key
# LLM_MODEL    : override the per-provider default
#
# Free tiers worth using (limits and model names move — check the provider):
#   groq        console.groq.com/keys        no card needed; 30 req/min, 14.4k/day
#   gemini      aistudio.google.com/apikey   free tier on flash models
#   openrouter  openrouter.ai/keys           several ":free" models
#
# Model names go stale. If you get "model not found", set LLM_MODEL to something
# current from the provider's list — the default in the code is only a default.
# Paid, if you want the strongest judgement:
#   anthropic   console.anthropic.com
#   openai      platform.openai.com/api-keys
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=          # only for a self-hosted / proxied endpoint

# =============================================================================
# CADENCE & AUTONOMY (optional — the defaults are the documented behaviour)
# =============================================================================
# Seconds between full deterministic reviews. Bids are NOT gated by this: they
# run off their own deadlines, every tick. On top of this cadence a review is
# triggered on the spot by a sale, a clausulazo or new LaLiga listings.
# FANTASYBOT_REVIEW_INTERVAL=1200

# Seconds between LLM strategic passes. Keep this long — it is the only thing
# here that costs money. Default: once a day.
# FANTASYBOT_LLM_INTERVAL=86400

# How many seconds before a listing closes the bid action becomes due. The
# function then polls the market into the final seconds.
# FANTASYBOT_BID_LEAD_SECONDS=60

# Autonomy. Matches the CLI's documented behaviour: lineup and bids are
# reversible so they are automatic; buyout clauses are irreversible spending so
# they are left as a task for you to confirm.
# FANTASYBOT_AUTO_EXECUTE=true
# FANTASYBOT_AUTO_LINEUP=true
# FANTASYBOT_AUTO_BIDS=true
#
# Buyout clauses are the biggest source of value in the game AND the only
# irreversible spend. On by default, fenced by MAX_CLAUSE_SHARE, CASH_RESERVE
# and MAX_CLAUSE below, and never paid inside LaLiga's pre-gameweek window.
# Targets come from every rival SQUAD, not only from what rivals list.
# FANTASYBOT_AUTO_CLAUSES=true
#
# Shield our most clause-vulnerable player. Free and purely defensive.
# FANTASYBOT_AUTO_SHIELD=true
#
# Keep the whole squad listed on the market at reserve prices. Listing is not
# selling, so this parts with nobody on its own.
# FANTASYBOT_AUTO_LIST=true
# Accept offers that meet a player's FLOOR (what we take, which is not the ask
# LaLiga forces above value). THIS is the one that sells. If it is false in your
# Vercel environment, the bot publishes and never sells.
# FANTASYBOT_AUTO_SELLS=true
# Decline a RIVAL's offer below the floor. LaLiga's own daily offer below it is
# left standing instead: it becomes the right one when the bank goes negative.
# FANTASYBOT_DECLINE_LOWBALLS=true
#
# Bid with LaLiga's credit, not only with cash. The game lets a squad bid up to
# cash + DEBT_SHARE of its value; a team that STARTS a gameweek negative scores
# zero, so the bot only borrows what its bench can repay, with CREDIT_MIN_HOURS
# of LaLiga's daily offers before the next first kick-off, and only after it has
# seen one of those offers arrive. How much of the line each mode uses is a mode
# knob (credit_use).
# FANTASYBOT_AUTO_CREDIT=true
# FANTASYBOT_DEBT_SHARE=0.20
# FANTASYBOT_CREDIT_MIN_HOURS=50
#
# Claim LaLiga's daily reward (100k/day in a private league). Free.
# FANTASYBOT_AUTO_DAILY_REWARD=true
#
# Re-optimise the XI before each kickoff. Players lock when THEIR match starts,
# so a Sunday striker can still be swapped on Saturday night. Free points.
# FANTASYBOT_AUTO_MATCHDAY_LINEUP=true
# FANTASYBOT_LINEUP_LEAD_MINUTES=25

# --- spending limits ---
# Cash the bot must always leave in the bank. The modes default to none — idle
# cash scores nothing, and the credit line is what answers the next close — so
# this is how you raise it if you want one.
# FANTASYBOT_CASH_RESERVE=0
# The most of the balance one buyout clause may take.
# FANTASYBOT_MAX_CLAUSE_SHARE=0.60
# Hard ceiling on a single buyout clause. 0 = no ceiling beyond the balance.
# FANTASYBOT_MAX_CLAUSE=0

# Function time budgets. Vercel Hobby kills a request at 60s; these stop short
# of that so a tick always gets to write its state before it dies.
# TICK_BUDGET_SECONDS=45
# SNIPER_BUDGET_SECONDS=50
